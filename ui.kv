#:import SlideTransition kivy.uix.screenmanager.SlideTransition

# ======================================================================
# 通用控件
# ======================================================================

<RoundButton@Button>:
    font_name: app.font_name
    font_size: sp(15)
    size_hint_y: None
    height: dp(46)
    background_normal: ''
    background_down: ''
    background_color: 0, 0, 0, 0
    color: (0.42, 0.47, 0.44, 1) if self.disabled else (1, 1, 1, 1)
    canvas.before:
        Color:
            rgba: app.COLOR_DISABLED if self.disabled else (app.COLOR_PRIMARY_DARK if self.state == 'down' else app.COLOR_PRIMARY)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(12)]

# 「登录」页那种长条按钮（仿微信"我的"）
<LongButton@Button>:
    font_name: app.font_name
    font_size: sp(16)
    size_hint_y: None
    height: dp(56)
    background_normal: ''
    background_down: ''
    background_color: 0, 0, 0, 0
    color: (0.62, 0.67, 0.64, 1) if self.disabled else app.COLOR_TEXT
    halign: 'left'
    valign: 'middle'
    text_size: self.size
    padding: dp(22), 0
    canvas.before:
        Color:
            rgba: (0.905, 0.968, 0.925, 1) if self.state == 'down' else (1, 1, 1, 1)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(14)]
        Color:
            rgba: app.COLOR_DISABLED if self.disabled else app.COLOR_PRIMARY
        RoundedRectangle:
            pos: self.x + dp(8), self.center_y - dp(11)
            size: dp(4), dp(22)
            radius: [dp(2)]
        Color:
            rgba: app.COLOR_LINE
        Line:
            width: 1
            rounded_rectangle: self.x, self.y, self.width, self.height, dp(14)

<TextLink@Button>:
    font_name: app.font_name
    font_size: sp(13)
    size_hint_y: None
    height: dp(34)
    background_normal: ''
    background_down: ''
    background_color: 0, 0, 0, 0
    color: app.COLOR_PRIMARY_DARK

<FieldInput@TextInput>:
    font_name: app.font_name
    font_size: sp(15)
    multiline: False
    size_hint_y: None
    height: dp(50)
    background_normal: ''
    background_active: ''
    background_color: 0, 0, 0, 0
    foreground_color: app.COLOR_TEXT
    cursor_color: app.COLOR_PRIMARY
    hint_text_color: 0.55, 0.64, 0.58, 1
    padding: dp(14), dp(14), dp(14), dp(14)
    canvas.before:
        Color:
            rgba: 1, 1, 1, 1
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(12)]
        Color:
            rgba: app.COLOR_PRIMARY if self.focus else app.COLOR_LINE
        Line:
            width: 1.2
            rounded_rectangle: self.x, self.y, self.width, self.height, dp(12)

<Card@BoxLayout>:
    orientation: 'vertical'
    padding: dp(16)
    spacing: dp(10)
    size_hint_y: None
    height: self.minimum_height
    canvas.before:
        Color:
            rgba: app.COLOR_CARD
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(16)]
        Color:
            rgba: app.COLOR_LINE
        Line:
            width: 1
            rounded_rectangle: self.x, self.y, self.width, self.height, dp(16)

# 分区小标题
<SectionTitle@Label>:
    font_name: app.font_name
    font_size: sp(14)
    bold: True
    color: app.COLOR_PRIMARY_DARK
    halign: 'left'
    valign: 'middle'
    text_size: self.size
    size_hint_y: None
    height: dp(26)

# 分区说明小字
<SectionNote@Label>:
    font_name: app.font_name
    font_size: sp(11)
    color: app.COLOR_TEXT_WEAK
    halign: 'left'
    valign: 'top'
    text_size: self.size
    size_hint_y: None
    height: dp(18)

# 弹窗正文一律白字：弹窗是黑底，深墨绿字在手机上几乎看不见
<ServiceRow>:
    font_name: app.font_name
    font_size: sp(11)
    color: 1, 1, 1, 0.96
    halign: 'left'
    valign: 'top'
    text_size: self.size
    size_hint_y: None
    height: dp(52)

<PopupRow>:
    font_name: app.font_name
    font_size: sp(11)
    color: 1, 1, 1, 0.96
    halign: 'left'
    valign: 'top'
    text_size: self.size
    size_hint_y: None
    height: dp(40)

<LogEntryRow>:
    font_name: app.font_name
    font_size: sp(11)
    color: 1, 1, 1, 0.96
    halign: 'left'
    valign: 'top'
    text_size: self.size
    size_hint_y: None
    height: dp(30)

# 主界面/服务页上固定显示的检验行：一行一个固定高度标签，
# 与状态卡绿字同一套写法（该写法已在手机上验证可正常显示）
<DiagLine@Label>:
    font_name: app.font_name
    font_size: sp(10)
    color: 1, 1, 1, 0.96
    halign: 'left'
    valign: 'top'
    text_size: self.size
    size_hint_y: None
    height: dp(18)

# 显示屏里的一行：白字、固定行高（可见区大约正好放 10 行）
<ScreenLine>:
    font_name: app.font_name
    font_size: sp(11)
    color: 1, 1, 1, 0.95
    halign: 'left'
    valign: 'middle'
    text_size: self.size
    size_hint_y: None
    height: dp(20)

<DeviceRow>:
    font_name: app.font_name
    font_size: sp(13)
    size_hint_y: None
    height: dp(60)
    halign: 'left'
    valign: 'middle'
    text_size: self.size
    padding_x: dp(14)
    color: app.COLOR_TEXT
    canvas.before:
        Color:
            rgba: (0.898, 0.973, 0.918, 1) if self.state == 'down' else (1, 1, 1, 1)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(10)]
        Color:
            rgba: app.COLOR_LINE
        Line:
            width: 1
            rounded_rectangle: self.x, self.y, self.width, self.height, dp(10)

# 圆形渐变按钮（蓝牙连接 / 功能键 / 日志格子共用）
<CircleButton>:
    circle: True
    radius: 0
    Label:
        text: root.text
        font_name: app.font_name
        font_size: root.font_size_hint
        bold: True
        color: 1, 1, 1, 1 if not root.disabled else 0.75
        halign: 'center'
        valign: 'middle'
        text_size: self.size

# 底部导航按钮
<TabButton>:
    radius: dp(16)
    circle: False
    color_a: app.GRAD_TAB_A if self.active else (0.929, 0.957, 0.941, 1)
    color_b: app.GRAD_TAB_B if self.active else (0.929, 0.957, 0.941, 1)
    Label:
        text: root.text
        font_name: app.font_name
        font_size: sp(14)
        bold: True
        color: (1, 1, 1, 1) if root.active else (0.38, 0.46, 0.41, 1)
        halign: 'center'
        valign: 'middle'
        text_size: self.size

# 未登录时盖在模块上的半透明灰色遮罩
<GateOverlay>:
    canvas.before:
        Color:
            rgba: 0.35, 0.39, 0.37, 0.62
        Rectangle:
            pos: self.pos
            size: self.size
    BoxLayout:
        orientation: 'vertical'
        size_hint: None, None
        width: dp(220)
        height: dp(76)
        pos_hint: {'center_x': 0.5, 'center_y': 0.5}
        Label:
            text: '登录后即可使用'
            font_name: app.font_name
            font_size: sp(18)
            bold: True
            color: 1, 1, 1, 0.96
            halign: 'center'
            valign: 'middle'
            text_size: self.size
            size_hint_y: None
            height: dp(40)
        Label:
            text: '请到「登录」模块完成用户登录'
            font_name: app.font_name
            font_size: sp(12)
            color: 0.92, 0.96, 0.94, 0.92
            halign: 'center'
            valign: 'middle'
            text_size: self.size
            size_hint_y: None
            height: dp(24)

# ======================================================================
# 根容器：页面 + 常驻底部导航
# ======================================================================

<RootTabs>:
    orientation: 'vertical'
    ScreenManager:
        id: sm
        transition: SlideTransition()
        CtrlScreen:
            name: 'ctrl'
        LogsScreen:
            name: 'logs'
        MineScreen:
            name: 'mine'
        LoginScreen:
            name: 'loginform'
        RegisterScreen:
            name: 'register'
    BoxLayout:
        orientation: 'horizontal'
        size_hint_y: None
        height: dp(64)
        padding: dp(10), dp(6), dp(10), dp(8)
        spacing: dp(10)
        canvas.before:
            Color:
                rgba: 1, 1, 1, 1
            Rectangle:
                pos: self.pos
                size: self.size
            Color:
                rgba: app.COLOR_LINE
            Line:
                width: 1
                points: self.x, self.top, self.right, self.top
        TabButton:
            text: '控 制'
            active: app.active_tab == 'ctrl'
            on_release: root.switch_tab('ctrl')
        TabButton:
            text: '记 录'
            active: app.active_tab == 'logs'
            on_release: root.switch_tab('logs')
        TabButton:
            text: '登 录'
            active: app.active_tab == 'mine'
            on_release: root.switch_tab('mine')

# ======================================================================
# 「控制」
# ======================================================================

<DisplayPanel>:
    orientation: 'vertical'
    canvas.before:
        Color:
            rgba: 1, 1, 1, 1
        RoundedRectangle:
            texture: app.navy_gradient
            pos: self.pos
            size: self.size
            radius: [dp(14)]
        Color:
            rgba: 0.40, 0.78, 0.98, 0.55
        Line:
            width: 1.2
            rounded_rectangle: self.x, self.y, self.width, self.height, dp(14)
    BoxLayout:
        orientation: 'vertical'
        padding: dp(10), dp(8), dp(8), dp(8)
        spacing: dp(6)
        Label:
            text: '▌ 数 据 显 示'
            font_name: app.font_name
            font_size: sp(12)
            bold: True
            color: 0.62, 0.89, 1, 1
            halign: 'left'
            valign: 'middle'
            text_size: self.size
            size_hint_y: None
            height: dp(18)
        BoxLayout:
            orientation: 'horizontal'
            spacing: dp(4)
            ScrollView:
                id: dp_scroll
                do_scroll_x: False
                bar_width: dp(4)
                GridLayout:
                    id: dp_lines
                    cols: 1
                    spacing: dp(2)
                    size_hint_y: None
                    # 至少撑满可视区：内容少时顶部对齐（否则 Kivy 会把它顶到底部，
                    # 上方留一大片空白、整体还会往下偏）
                    height: max(self.minimum_height, self.parent.height)
        BoxLayout:
            orientation: 'horizontal'
            spacing: dp(8)
            size_hint_y: None
            height: dp(32)
            Label:
                text: app.status_text
                font_name: app.font_name
                font_size: sp(11)
                color: 0.80, 0.94, 1, 1
                halign: 'left'
                valign: 'middle'
                text_size: self.size
            Button:
                text: '一键清屏'
                font_name: app.font_name
                font_size: sp(11)
                size_hint: None, None
                size: dp(84), dp(28)
                background_normal: ''
                background_down: ''
                background_color: 0, 0, 0, 0
                color: 0.90, 0.97, 1, 1
                canvas.before:
                    Color:
                        rgba: 1, 1, 1, (0.34 if self.state == 'down' else 0.20)
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [dp(8)]
                    Color:
                        rgba: 0.62, 0.89, 1, 0.85
                    Line:
                        width: 1
                        rounded_rectangle: self.x, self.y, self.width, self.height, dp(8)
                # 注意：这里在 <DisplayPanel> 规则里，root 是显示屏而不是页面。
                # 以前写成 root.clear_screen()，点下去直接 AttributeError 闪退。
                on_release: app.screen('ctrl').clear_screen()

<CtrlScreen>:
    FloatLayout:
        BoxLayout:
            orientation: 'vertical'
            padding: dp(14), dp(8), dp(14), dp(6)
            spacing: dp(8)
            canvas.before:
                Color:
                    rgba: app.COLOR_BG
                Rectangle:
                    pos: self.pos
                    size: self.size

            DisplayPanel

            BoxLayout:
                orientation: 'horizontal'
                spacing: dp(10)
                size_hint_y: None
                height: dp(72)
                CircleButton:
                    text: '蓝牙连接'
                    font_size_hint: sp(12)
                    color_a: app.GRAD_LINK_A
                    color_b: app.GRAD_LINK_B
                    border_color: 1, 1, 1, 0.8
                    on_release: root.open_device_dialog()
                CircleButton:
                    text: '断开连接'
                    font_size_hint: sp(12)
                    color_a: app.GRAD_LINK_A
                    color_b: app.GRAD_LINK_B
                    border_color: 1, 1, 1, 0.8
                    disabled: not app.connected
                    on_release: root.do_disconnect()
                CircleButton:
                    text: '服务/特征'
                    font_size_hint: sp(11)
                    color_a: app.GRAD_LINK_A
                    color_b: app.GRAD_LINK_B
                    border_color: 1, 1, 1, 0.8
                    disabled: not app.connected
                    on_release: root.open_services_dialog()

            GridLayout:
                cols: 4
                spacing: dp(8)
                size_hint_y: None
                height: dp(2 * 76 + 8)
                CircleButton:
                    text: '启动'
                    font_size_hint: sp(13)
                    color_a: app.GRAD_FUNC_A
                    color_b: app.GRAD_FUNC_B
                    disabled: not app.connected
                    on_release: root.send_preset('启动')
                CircleButton:
                    text: '停止'
                    font_size_hint: sp(13)
                    color_a: app.GRAD_FUNC_A
                    color_b: app.GRAD_FUNC_B
                    disabled: not app.connected
                    on_release: root.send_preset('停止')
                CircleButton:
                    text: '开发者'
                    font_size_hint: sp(12)
                    color_a: app.GRAD_FUNC_A
                    color_b: app.GRAD_FUNC_B
                    disabled: not app.connected
                    on_release: root.open_developer()
                CircleButton:
                    text: '功能四'
                    font_size_hint: sp(12)
                    color_a: app.GRAD_FUNC_A
                    color_b: app.GRAD_FUNC_B
                    disabled: not app.connected
                    on_release: root.reserved('功能四')
                CircleButton:
                    text: '功能五'
                    font_size_hint: sp(12)
                    color_a: app.GRAD_FUNC_A
                    color_b: app.GRAD_FUNC_B
                    disabled: not app.connected
                    on_release: root.reserved('功能五')
                CircleButton:
                    text: '功能六'
                    font_size_hint: sp(12)
                    color_a: app.GRAD_FUNC_A
                    color_b: app.GRAD_FUNC_B
                    disabled: not app.connected
                    on_release: root.reserved('功能六')
                CircleButton:
                    text: '功能七'
                    font_size_hint: sp(12)
                    color_a: app.GRAD_FUNC_A
                    color_b: app.GRAD_FUNC_B
                    disabled: not app.connected
                    on_release: root.reserved('功能七')
                CircleButton:
                    text: '功能八'
                    font_size_hint: sp(12)
                    color_a: app.GRAD_FUNC_A
                    color_b: app.GRAD_FUNC_B
                    disabled: not app.connected
                    on_release: root.reserved('功能八')

        GateOverlay:
            opacity: 1 if not app.logged_in else 0

# ======================================================================
# 「记录」
# ======================================================================

<LogsScreen>:
    FloatLayout:
        BoxLayout:
            orientation: 'vertical'
            padding: dp(16), dp(10)
            spacing: dp(8)
            canvas.before:
                Color:
                    rgba: app.COLOR_BG
                Rectangle:
                    pos: self.pos
                    size: self.size

            SectionTitle:
                text: '蓝牙日志'
            SectionNote:
                text: '每次退出登录，都会把本次登录期间显示屏里的内容存下来（最多 5 次）'
            GridLayout:
                cols: 5
                spacing: dp(8)
                size_hint_y: None
                height: dp(72)
                CircleButton:
                    text: '1'
                    font_size_hint: sp(18)
                    color_a: app.GRAD_LOG_A
                    color_b: app.GRAD_LOG_B
                    on_release: root.open_session(0)
                CircleButton:
                    text: '2'
                    font_size_hint: sp(18)
                    color_a: app.GRAD_LOG_A
                    color_b: app.GRAD_LOG_B
                    on_release: root.open_session(1)
                CircleButton:
                    text: '3'
                    font_size_hint: sp(18)
                    color_a: app.GRAD_LOG_A
                    color_b: app.GRAD_LOG_B
                    on_release: root.open_session(2)
                CircleButton:
                    text: '4'
                    font_size_hint: sp(18)
                    color_a: app.GRAD_LOG_A
                    color_b: app.GRAD_LOG_B
                    on_release: root.open_session(3)
                CircleButton:
                    text: '5'
                    font_size_hint: sp(18)
                    color_a: app.GRAD_LOG_A
                    color_b: app.GRAD_LOG_B
                    on_release: root.open_session(4)

            Widget:
                size_hint_y: 0.08

            SectionTitle:
                text: '诊断记录'
            SectionNote:
                text: '该功能暂时预留'
            GridLayout:
                cols: 5
                spacing: dp(8)
                size_hint_y: None
                height: dp(72)
                CircleButton:
                    text: '1'
                    font_size_hint: sp(18)
                    color_a: app.GRAD_LOG_A
                    color_b: app.GRAD_LOG_B
                    on_release: root.open_diag(0)
                CircleButton:
                    text: '2'
                    font_size_hint: sp(18)
                    color_a: app.GRAD_LOG_A
                    color_b: app.GRAD_LOG_B
                    on_release: root.open_diag(1)
                CircleButton:
                    text: '3'
                    font_size_hint: sp(18)
                    color_a: app.GRAD_LOG_A
                    color_b: app.GRAD_LOG_B
                    on_release: root.open_diag(2)
                CircleButton:
                    text: '4'
                    font_size_hint: sp(18)
                    color_a: app.GRAD_LOG_A
                    color_b: app.GRAD_LOG_B
                    on_release: root.open_diag(3)
                CircleButton:
                    text: '5'
                    font_size_hint: sp(18)
                    color_a: app.GRAD_LOG_A
                    color_b: app.GRAD_LOG_B
                    on_release: root.open_diag(4)

            Widget:
                size_hint_y: 0.1

        GateOverlay:
            opacity: 1 if not app.logged_in else 0

# ======================================================================
# 「登录」
# ======================================================================

<MineScreen>:
    FloatLayout:
        BoxLayout:
            orientation: 'vertical'
            padding: dp(18), dp(14)
            spacing: dp(10)
            canvas.before:
                Color:
                    rgba: app.COLOR_BG
                Rectangle:
                    pos: self.pos
                    size: self.size

            GradientPanel:
                color_a: app.GRAD_TAB_A
                color_b: app.GRAD_TAB_B
                radius: dp(16)
                size_hint_y: None
                height: dp(84)
                padding: dp(20), dp(14)
                spacing: dp(4)
                Label:
                    text: ('当前用户：%s' % app.current_user) if app.logged_in else '未登录'
                    font_name: app.font_name
                    font_size: sp(17)
                    bold: True
                    color: 1, 1, 1, 1
                    halign: 'left'
                    valign: 'middle'
                    text_size: self.size
                    size_hint_y: None
                    height: dp(30)
                Label:
                    text: '已解锁「控制」「记录」' if app.logged_in else '完成登录后自动解锁全部模块'
                    font_name: app.font_name
                    font_size: sp(12)
                    color: 0.92, 0.99, 0.94, 0.95
                    halign: 'left'
                    valign: 'middle'
                    text_size: self.size
                    size_hint_y: None
                    height: dp(24)

            Widget:
                size_hint_y: None
                height: dp(4)

            LongButton:
                text: '用户登录'
                on_release: root.open_login()

            LongButton:
                text: '紧急呼叫'
                disabled: not app.logged_in
                on_release: root.reserved('紧急呼叫')

            LongButton:
                text: '用户信息'
                disabled: not app.logged_in
                on_release: root.reserved('用户信息')

            LongButton:
                text: '问题查询'
                disabled: not app.logged_in
                on_release: root.reserved('问题查询')

            LongButton:
                text: '退出登录'
                opacity: 1 if app.logged_in else 0
                disabled: not app.logged_in
                size_hint_y: None
                height: dp(56) if app.logged_in else 0
                on_release: root.do_logout()

            Widget:

# ======================================================================
# 登录表单
# ======================================================================

<LoginScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: dp(22), dp(10)
        canvas.before:
            Color:
                rgba: app.COLOR_BG
            Rectangle:
                pos: self.pos
                size: self.size

        GradientPanel:
            color_a: app.GRAD_TAB_A
            color_b: app.GRAD_TAB_B
            radius: dp(18)
            size_hint_y: None
            height: dp(96)
            BoxLayout:
                orientation: 'vertical'
                padding: dp(18), dp(14)
                Label:
                    text: '绿联蓝牙助手'
                    font_name: app.font_name
                    font_size: sp(24)
                    bold: True
                    color: 1, 1, 1, 1
                    halign: 'left'
                    valign: 'middle'
                    text_size: self.size
                    size_hint_y: None
                    height: dp(36)
                Label:
                    text: '医疗设备蓝牙连接平台'
                    font_name: app.font_name
                    font_size: sp(12)
                    color: 0.92, 0.99, 0.94, 0.95
                    halign: 'left'
                    valign: 'middle'
                    text_size: self.size
                    size_hint_y: None
                    height: dp(22)

        Widget:
            size_hint_y: None
            height: dp(14)

        Card:
            size_hint_x: 1
            Label:
                text: '账号登录'
                font_name: app.font_name
                font_size: sp(17)
                bold: True
                color: app.COLOR_TEXT
                halign: 'left'
                text_size: self.size
                size_hint_y: None
                height: dp(28)
            FieldInput:
                id: username
                hint_text: '请输入用户名'
                on_text: root.message = ''
            FieldInput:
                id: password
                hint_text: '请输入密码'
                password: True
                on_text: root.message = ''
            Label:
                text: root.message
                font_name: app.font_name
                font_size: sp(12)
                color: app.COLOR_PRIMARY_DARK if root.message_ok else app.COLOR_DANGER
                halign: 'left'
                text_size: self.size
                size_hint_y: None
                height: dp(22) if root.message else 0
            RoundButton:
                text: '登 录'
                on_release: root.do_login()
            TextLink:
                text: '还没有账号？点此注册'
                on_release: root.goto_register()

        Widget:

# ======================================================================
# 注册页
# ======================================================================

<RegisterScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: dp(22), dp(10)
        canvas.before:
            Color:
                rgba: app.COLOR_BG
            Rectangle:
                pos: self.pos
                size: self.size

        Widget:
            size_hint_y: 0.06

        Label:
            text: '注册新账号'
            font_name: app.font_name
            font_size: sp(22)
            bold: True
            color: app.COLOR_PRIMARY_DARK
            size_hint_y: None
            height: dp(36)

        Label:
            text: '账号仅保存在本机，暂不提供密码找回'
            font_name: app.font_name
            font_size: sp(12)
            color: app.COLOR_TEXT_WEAK
            size_hint_y: None
            height: dp(20)

        Widget:
            size_hint_y: None
            height: dp(14)

        Card:
            size_hint_x: 1
            FieldInput:
                id: username
                hint_text: '设置用户名（3-20 个字符）'
                on_text: root.message = ''
            FieldInput:
                id: password
                hint_text: '设置密码（至少 6 位）'
                password: True
                on_text: root.message = ''
            FieldInput:
                id: confirm
                hint_text: '请再次输入密码'
                password: True
                on_text: root.message = ''
            Label:
                text: root.message
                font_name: app.font_name
                font_size: sp(12)
                color: app.COLOR_PRIMARY_DARK if root.message_ok else app.COLOR_DANGER
                halign: 'left'
                text_size: self.size
                size_hint_y: None
                height: dp(22) if root.message else 0
            RoundButton:
                text: '注 册'
                on_release: root.do_register()
            TextLink:
                text: '返回登录'
                on_release: root.back_to_login()

        Widget:

# ======================================================================
# 弹窗
# ======================================================================

<InfoPopup>:
    title_font: app.font_name
    title_size: sp(15)
    title_color: 1, 1, 1, 1
    separator_color: 1, 1, 1, 0.22
    background_color: 0.06, 0.10, 0.08, 1
    size_hint: 0.92, None
    height: dp(420)
    BoxLayout:
        orientation: 'vertical'
        spacing: dp(6)
        padding: dp(6)
        BoxLayout:
            id: info_lines
            orientation: 'vertical'
            spacing: dp(2)

<DevicePopup>:
    title: '附近的 BLE 设备'
    title_font: app.font_name
    title_size: sp(16)
    title_color: 1, 1, 1, 1
    separator_color: 1, 1, 1, 0.22
    background_color: 0.06, 0.10, 0.08, 1
    size_hint: 0.94, 0.86
    BoxLayout:
        orientation: 'vertical'
        spacing: dp(6)
        padding: dp(6)
        Label:
            id: popup_status
            text: '正在扫描…'
            font_name: app.font_name
            font_size: sp(12)
            color: 0.86, 0.96, 0.90, 1
            halign: 'left'
            text_size: self.size
            size_hint_y: None
            height: dp(22)
        ScrollView:
            do_scroll_x: False
            bar_width: dp(3)
            GridLayout:
                id: device_list
                cols: 1
                spacing: dp(6)
                size_hint_y: None
                height: self.minimum_height
        Label:
            id: popup_diag
            text: ''
            font_name: app.font_name
            font_size: sp(10)
            color: 0.78, 0.90, 0.83, 1
            halign: 'left'
            valign: 'top'
            text_size: self.size
            size_hint_y: None
            height: dp(18)
        BoxLayout:
            orientation: 'horizontal'
            spacing: dp(8)
            size_hint_y: None
            height: dp(44)
            RoundButton:
                text: '我的收藏'
                font_size: sp(13)
                on_release: root.open_favorites()
            RoundButton:
                text: '重新扫描'
                font_size: sp(13)
                on_release: root.restart_scan()
            RoundButton:
                text: '关闭'
                font_size: sp(13)
                on_release: root.dismiss()

<FavoritePopup>:
    title: '我的收藏'
    title_font: app.font_name
    title_size: sp(16)
    title_color: 1, 1, 1, 1
    separator_color: 1, 1, 1, 0.22
    background_color: 0.06, 0.10, 0.08, 1
    size_hint: 0.94, 0.8
    BoxLayout:
        orientation: 'vertical'
        spacing: dp(6)
        padding: dp(6)
        Label:
            id: fav_state
            text: '只显示当前扫描得到的收藏设备'
            font_name: app.font_name
            font_size: sp(12)
            color: 0.86, 0.96, 0.90, 1
            halign: 'left'
            text_size: self.size
            size_hint_y: None
            height: dp(22)
        ScrollView:
            do_scroll_x: False
            bar_width: dp(3)
            GridLayout:
                id: fav_list
                cols: 1
                spacing: dp(6)
                size_hint_y: None
                height: max(self.minimum_height, self.parent.height)
        BoxLayout:
            orientation: 'horizontal'
            spacing: dp(8)
            size_hint_y: None
            height: dp(44)
            RoundButton:
                text: '关 闭'
                font_size: sp(13)
                on_release: root.dismiss()

<ServicesPopup>:
    title: '服务 / 特征'
    title_font: app.font_name
    title_size: sp(16)
    title_color: 1, 1, 1, 1
    separator_color: 1, 1, 1, 0.22
    background_color: 0.06, 0.10, 0.08, 1
    size_hint: 0.94, 0.9
    BoxLayout:
        orientation: 'vertical'
        spacing: dp(6)
        padding: dp(6)
        Label:
            text: '下面列出设备暴露的全部服务与特征。把要写入的 UUID 填进 main.py 的 ESP32_WRITE_UUID 即可。'
            font_name: app.font_name
            font_size: sp(11)
            color: 0.78, 0.90, 0.83, 1
            halign: 'left'
            valign: 'top'
            text_size: self.size
            size_hint_y: None
            height: dp(34)
        Label:
            id: service_state
            text: '尚未发现服务'
            font_name: app.font_name
            font_size: sp(11)
            color: 1, 1, 1, 0.96
            halign: 'left'
            valign: 'top'
            text_size: self.size
            size_hint_y: None
            height: dp(46)
        ScrollView:
            do_scroll_x: False
            bar_width: dp(3)
            GridLayout:
                id: service_list
                cols: 1
                spacing: dp(6)
                size_hint_y: None
                height: max(self.minimum_height, self.parent.height)
        Label:
            id: module_state
            text: '模块信息（AT 通道读取）：准备中…'
            font_name: app.font_name
            font_size: sp(11)
            color: 1, 1, 1, 0.96
            halign: 'left'
            valign: 'top'
            text_size: self.size
            size_hint_y: None
            height: dp(18)
        DiagLine:
            id: svc_diag_1
            text: '固件版本：未查询'
        DiagLine:
            id: svc_diag_2
            text: '设备角色：未查询'
        DiagLine:
            id: svc_diag_3
            text: '串口波特率：未查询'
        DiagLine:
            id: svc_diag_4
            text: '状态显示：未查询'
        DiagLine:
            id: svc_diag_5
            text: '用户鉴权：未查询'
        DiagLine:
            id: svc_diag_6
            text: '设备名称：未查询'
        BoxLayout:
            orientation: 'horizontal'
            spacing: dp(8)
            size_hint_y: None
            height: dp(44)
            RoundButton:
                text: '重新发现'
                font_size: sp(11)
                on_release: root.retry_discovery()
            RoundButton:
                text: '复制列表'
                font_size: sp(11)
                on_release: root.copy_list()
            RoundButton:
                text: '刷新信息'
                font_size: sp(11)
                on_release: root.refresh_module_info()
            RoundButton:
                text: '关闭'
                font_size: sp(11)
                on_release: root.dismiss()

<LogDetailPopup>:
    title_font: app.font_name
    title_size: sp(15)
    title_color: 1, 1, 1, 1
    separator_color: 1, 1, 1, 0.22
    background_color: 0.06, 0.10, 0.08, 1
    size_hint: 0.94, 0.86
    BoxLayout:
        orientation: 'vertical'
        spacing: dp(6)
        padding: dp(6)
        Label:
            id: log_state
            text: ''
            font_name: app.font_name
            font_size: sp(12)
            color: 1, 1, 1, 0.96
            halign: 'left'
            valign: 'top'
            text_size: self.size
            size_hint_y: None
            height: dp(24)
        ScrollView:
            id: log_scroll
            do_scroll_x: False
            bar_width: dp(3)
            GridLayout:
                id: log_list
                cols: 1
                spacing: dp(4)
                size_hint_y: None
                height: max(self.minimum_height, self.parent.height)
        RoundButton:
            text: '关 闭'
            on_release: root.dismiss()

<CommandInputPopup>:
    title: '开发者：自定义命令包'
    title_font: app.font_name
    title_size: sp(15)
    title_color: 1, 1, 1, 1
    separator_color: 1, 1, 1, 0.22
    background_color: 0.06, 0.10, 0.08, 1
    size_hint: 0.95, 0.84
    BoxLayout:
        orientation: 'vertical'
        spacing: dp(6)
        padding: dp(6)

        Label:
            text: '填入十六进制命令包（偶数长度，例如 5401008031），点「发送」写进数据通道'
            font_name: app.font_name
            font_size: sp(11)
            color: 0.78, 0.90, 0.83, 1
            halign: 'left'
            valign: 'top'
            text_size: self.size
            size_hint_y: None
            height: dp(32)

        TextInput:
            id: cmd_input
            text: root.command
            font_name: app.font_name
            font_size: sp(13)
            multiline: False
            size_hint_y: None
            height: dp(44)
            on_text: root.command = self.text

        BoxLayout:
            orientation: 'horizontal'
            spacing: dp(6)
            size_hint_y: None
            height: dp(44)
            RoundButton:
                text: '发送'
                font_size: sp(13)
                on_release: root.send()
            RoundButton:
                text: '关闭'
                font_size: sp(13)
                on_release: root.dismiss()

        Label:
            text: root.state
            font_name: app.font_name
            font_size: sp(11)
            color: 0.86, 0.96, 0.90, 1
            halign: 'left'
            valign: 'top'
            text_size: self.size
            size_hint_y: None
            height: dp(32)

        BoxLayout:
            id: cmd_reply
            orientation: 'vertical'
            spacing: dp(2)
