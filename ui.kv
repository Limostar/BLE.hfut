#:import SlideTransition kivy.uix.screenmanager.SlideTransition

# ======================================================================
# 通用控件 —— 医疗科技风：浅灰蓝底、白色卡片、深青主色、方形圆角
# ======================================================================

<Card@BoxLayout>:
    orientation: 'vertical'
    padding: dp(14)
    spacing: dp(8)
    size_hint_y: None
    height: self.minimum_height
    canvas.before:
        Color:
            rgba: 0.18, 0.50, 0.93, 0.10
        RoundedRectangle:
            pos: self.x, self.y - dp(3)
            size: self.width, self.height + dp(3)
            radius: [dp(20)]
        Color:
            rgba: app.COLOR_CARD
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(18)]
        Color:
            rgba: 0.18, 0.50, 0.93, 0.30
        Line:
            width: 1.2
            rounded_rectangle: self.x, self.y, self.width, self.height, dp(18)

# 方形圆角按钮：filled=True 实心，filled=False 白底描边
<SquareButton>:
    font_name: app.font_name
    font_size: sp(15)
    bold: True
    size_hint_y: None
    height: dp(52)
    background_normal: ''
    background_down: ''
    background_color: 0, 0, 0, 0
    color: (1, 1, 1, 1) if self.filled else (app.COLOR_DISABLED if self.disabled else self.accent)
    canvas.before:
        Color:
            rgba: app.COLOR_DISABLED if self.disabled else (self.accent if self.filled else (1, 1, 1, 1))
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(16)]
        Color:
            rgba: (0, 0, 0, 0) if self.filled else (app.COLOR_DISABLED if self.disabled else self.accent)
        Line:
            width: 1.2
            rounded_rectangle: self.x, self.y, self.width, self.height, dp(16)

# 底部导航（选中实心、未选中白底描边，直接用 SquareButton 的样式）
<TabButton>:
    font_size: sp(14)
    filled: self.active
    accent: app.COLOR_PRIMARY

# 「登录」页那种长条按钮
<LongButton@Button>:
    font_name: app.font_name
    font_size: sp(16)
    size_hint_y: None
    height: dp(56)
    background_normal: ''
    background_down: ''
    background_color: 0, 0, 0, 0
    color: (0.62, 0.67, 0.64, 1) if self.disabled else app.COLOR_TEXT
    halign: 'left'
    valign: 'middle'
    text_size: self.size
    padding: dp(22), 0
    canvas.before:
        Color:
            rgba: (0.94, 0.97, 0.98, 1) if self.state == 'down' else (1, 1, 1, 1)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(16)]
        Color:
            rgba: app.COLOR_DISABLED if self.disabled else app.COLOR_PRIMARY
        RoundedRectangle:
            pos: self.x + dp(10), self.center_y - dp(10)
            size: dp(4), dp(20)
            radius: [dp(2)]
        Color:
            rgba: app.COLOR_LINE
        Line:
            width: 1
            rounded_rectangle: self.x, self.y, self.width, self.height, dp(16)

<TextLink@Button>:
    font_name: app.font_name
    font_size: sp(13)
    size_hint_y: None
    height: dp(34)
    background_normal: ''
    background_down: ''
    background_color: 0, 0, 0, 0
    color: app.COLOR_PRIMARY

<FieldInput@TextInput>:
    font_name: app.font_name
    font_size: sp(15)
    multiline: False
    size_hint_y: None
    height: dp(50)
    background_normal: ''
    background_active: ''
    background_color: 0, 0, 0, 0
    foreground_color: app.COLOR_TEXT
    cursor_color: app.COLOR_PRIMARY
    # 未输入时的提示字：略深的灰，不能太浅（浅到看不清）
    hint_text_color: 0.40, 0.45, 0.51, 1
    padding: dp(14), dp(14), dp(14), dp(14)
    canvas.before:
        Color:
            rgba: 1, 1, 1, 1
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(12)]
        Color:
            rgba: app.COLOR_PRIMARY if self.focus else (0.72, 0.76, 0.81, 1)
        Line:
            width: 1.2
            rounded_rectangle: self.x, self.y, self.width, self.height, dp(12)

# 分区小标题
<SectionTitle@Label>:
    font_name: app.font_name
    font_size: sp(16)
    bold: True
    color: app.COLOR_TEXT
    halign: 'left'
    valign: 'middle'
    text_size: self.size
    size_hint_y: None
    height: dp(28)

# 分区说明小字
<SectionNote@Label>:
    font_name: app.font_name
    font_size: sp(12)
    color: app.COLOR_TEXT_WEAK
    halign: 'left'
    valign: 'top'
    text_size: self.size
    size_hint_y: None
    height: dp(20)

# ---- 弹窗正文行（弹窗是深色底，白字）----
<ServiceRow>:
    font_name: app.font_name
    font_size: sp(11)
    color: 1, 1, 1, 0.96
    halign: 'left'
    valign: 'top'
    text_size: self.size
    size_hint_y: None
    height: dp(52)

<PopupRow>:
    font_name: app.font_name
    font_size: sp(12)
    color: 1, 1, 1, 0.96
    halign: 'left'
    valign: 'top'
    text_size: self.size
    size_hint_y: None
    height: dp(34)

<DiagLine@Label>:
    font_name: app.font_name
    font_size: sp(10)
    color: 1, 1, 1, 0.96
    halign: 'left'
    valign: 'top'
    text_size: self.size
    size_hint_y: None
    height: dp(18)

# 显示屏里的一行：白字、固定行高
<ScreenLine>:
    font_name: app.font_name
    font_size: sp(11)
    color: 1, 1, 1, 0.95
    halign: 'left'
    valign: 'middle'
    text_size: self.size
    size_hint_y: None
    height: dp(20)

<DeviceRow>:
    font_name: app.font_name
    font_size: sp(13)
    size_hint_y: None
    height: dp(60)
    halign: 'left'
    valign: 'middle'
    text_size: self.size
    padding_x: dp(14)
    color: app.COLOR_TEXT
    canvas.before:
        Color:
            rgba: (0.94, 0.97, 0.98, 1) if self.state == 'down' else (1, 1, 1, 1)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(10)]
        Color:
            rgba: app.COLOR_LINE
        Line:
            width: 1
            rounded_rectangle: self.x, self.y, self.width, self.height, dp(10)

# 未登录时盖在模块上的遮罩
<GateOverlay>:
    canvas.before:
        Color:
            rgba: 0.965, 0.973, 0.980, 0.80
        Rectangle:
            pos: self.pos
            size: self.size
    BoxLayout:
        orientation: 'vertical'
        size_hint: None, None
        width: dp(240)
        height: dp(84)
        pos_hint: {'center_x': 0.5, 'center_y': 0.5}
        Label:
            text: '登录后即可使用'
            font_name: app.font_name
            font_size: sp(18)
            bold: True
            color: app.COLOR_PRIMARY
            halign: 'center'
            valign: 'middle'
            text_size: self.size
            size_hint_y: None
            height: dp(40)
        Label:
            text: '请到「登录」模块完成用户登录'
            font_name: app.font_name
            font_size: sp(13)
            color: app.COLOR_TEXT_WEAK
            halign: 'center'
            valign: 'middle'
            text_size: self.size
            size_hint_y: None
            height: dp(26)

# ======================================================================
# 顶部全局状态条（固定，不随内容滚动）
# ======================================================================
<StatusBar>:
    orientation: 'horizontal'
    size_hint_y: None
    height: dp(68)
    padding: dp(16), dp(8)
    spacing: dp(10)
    canvas.before:
        Color:
            rgba: app.COLOR_DANGER if app.bar_mode == 'alarm' else app.COLOR_CARD
        Rectangle:
            pos: self.pos
            size: self.size
        Color:
            rgba: (1, 1, 1, 0.30) if app.bar_mode == 'alarm' else app.COLOR_LINE
        Line:
            width: 1
            points: self.x, self.y, self.right, self.y
    BoxLayout:
        orientation: 'vertical'
        spacing: dp(0)
        Label:
            text: '告警' if app.bar_mode == 'alarm' else ('记录' if app.bar_mode == 'notice' else '患者身份')
            font_name: app.font_name
            font_size: sp(12)
            color: (1, 1, 1, 0.85) if app.bar_mode != 'patient' else app.COLOR_TEXT_WEAK
            halign: 'left'
            valign: 'bottom'
            text_size: self.size
            size_hint_y: None
            height: dp(20)
        Label:
            text: (app.bar_message if app.bar_mode != 'patient' else app.patient_label)
            font_name: app.font_name
            font_size: sp(20)
            bold: True
            color: (1, 1, 1, 1) if app.bar_mode != 'patient' else app.COLOR_TEXT
            halign: 'left'
            valign: 'top'
            text_size: self.size
            size_hint_y: None
            height: dp(32)
            opacity: app.bar_opacity
    Label:
        text: '已连接' if app.connected else '未连接'
        font_name: app.font_name
        font_size: sp(12)
        bold: True
        color: (1, 1, 1, 1) if app.bar_mode == 'alarm' else (app.COLOR_OK if app.connected else app.COLOR_TEXT_WEAK)
        size_hint: None, None
        size: dp(72), dp(30)
        pos_hint: {'center_y': 0.5}
        canvas.before:
            Color:
                rgba: (1, 1, 1, 0.20) if app.bar_mode == 'alarm' else ((0.07, 0.72, 0.42, 0.14) if app.connected else (0.596, 0.635, 0.702, 0.14))
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [dp(9)]

# ======================================================================
# 根容器：状态条 + 页面 + 底部导航（开发者模式换一套）
# ======================================================================
<RootTabs>:
    orientation: 'vertical'
    StatusBar:
    ScreenManager:
        id: sm
        transition: SlideTransition()
        CtrlScreen:
            name: 'ctrl'
        DevScreen:
            name: 'dev'
        LogsScreen:
            name: 'logs'
        MineScreen:
            name: 'mine'
        LoginScreen:
            name: 'loginform'
        RegisterScreen:
            name: 'register'
    BoxLayout:
        id: nav_bar
        orientation: 'horizontal'
        size_hint_y: None
        # 留出底部安全区（手机手势条会吃掉最下面约 24dp 的触摸）
        height: dp(86)
        padding: dp(10), dp(8), dp(10), dp(24)
        spacing: dp(8)
        canvas.before:
            Color:
                rgba: 1, 1, 1, 1
            Rectangle:
                pos: self.pos
                size: self.size
            Color:
                rgba: app.COLOR_LINE
            Line:
                width: 1
                points: self.x, self.top, self.right, self.top

# ======================================================================
# 开发者显示屏（沿用已验证的滚动显示屏）
# ======================================================================
<DisplayPanel>:
    orientation: 'vertical'
    canvas.before:
        Color:
            rgba: 1, 1, 1, 1
        RoundedRectangle:
            texture: app.navy_gradient
            pos: self.pos
            size: self.size
            radius: [dp(16)]
        Color:
            rgba: 0.18, 0.50, 0.93, 0.35
        Line:
            width: 1.2
            rounded_rectangle: self.x, self.y, self.width, self.height, dp(16)
    BoxLayout:
        orientation: 'vertical'
        padding: dp(10), dp(8), dp(8), dp(8)
        spacing: dp(6)
        Label:
            text: '▌ 数 据 显 示'
            font_name: app.font_name
            font_size: sp(12)
            bold: True
            color: 0.62, 0.89, 0.86, 1
            halign: 'left'
            valign: 'middle'
            text_size: self.size
            size_hint_y: None
            height: dp(18)
        BoxLayout:
            orientation: 'horizontal'
            spacing: dp(4)
            ScrollView:
                id: dp_scroll
                do_scroll_x: False
                bar_width: dp(4)
                GridLayout:
                    id: dp_lines
                    cols: 1
                    spacing: dp(2)
                    size_hint_y: None
                    height: max(self.minimum_height, self.parent.height)
        BoxLayout:
            orientation: 'horizontal'
            spacing: dp(8)
            size_hint_y: None
            height: dp(32)
            Label:
                text: app.status_text
                font_name: app.font_name
                font_size: sp(11)
                color: 0.80, 0.94, 0.95, 1
                halign: 'left'
                valign: 'middle'
                text_size: self.size
            Button:
                text: '一键清屏'
                font_name: app.font_name
                font_size: sp(11)
                size_hint: None, None
                size: dp(84), dp(28)
                background_normal: ''
                background_down: ''
                background_color: 0, 0, 0, 0
                color: 0.90, 0.97, 1, 1
                canvas.before:
                    Color:
                        rgba: 1, 1, 1, (0.34 if self.state == 'down' else 0.20)
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [dp(8)]
                    Color:
                        rgba: 0.62, 0.89, 0.86, 0.85
                    Line:
                        width: 1
                        rounded_rectangle: self.x, self.y, self.width, self.height, dp(8)
                on_release: app.screen('dev').clear_screen()

# ======================================================================
# 「控制」——设备监测 + 9 个功能键 + 蓝牙 / 患者 / 开发者
# ======================================================================
<CtrlScreen>:
    FloatLayout:
        canvas.before:
            Color:
                rgba: app.COLOR_BG
            Rectangle:
                pos: self.pos
                size: self.size
        ScrollView:
            do_scroll_x: False
            bar_width: dp(2)
            BoxLayout:
                orientation: 'vertical'
                padding: dp(12), dp(10)
                spacing: dp(10)
                size_hint_y: None
                height: self.minimum_height

                # ---------------- 监测卡 ----------------
                BoxLayout:
                    orientation: 'horizontal'
                    size_hint_y: None
                    height: dp(208)
                    padding: dp(14)
                    spacing: dp(10)
                    canvas.before:
                        Color:
                            rgba: 0.18, 0.50, 0.93, 0.10
                        RoundedRectangle:
                            pos: self.x, self.y - dp(3)
                            size: self.width, self.height + dp(3)
                            radius: [dp(20)]
                        Color:
                            rgba: app.COLOR_CARD
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [dp(18)]
                        Color:
                            rgba: 0.18, 0.50, 0.93, 0.30
                        Line:
                            width: 1.2
                            rounded_rectangle: self.x, self.y, self.width, self.height, dp(18)

                    BoxLayout:
                        orientation: 'vertical'
                        spacing: dp(4)
                        Label:
                            text: '设备监测'
                            font_name: app.font_name
                            font_size: sp(12)
                            bold: True
                            color: app.COLOR_TEXT_WEAK
                            halign: 'left'
                            valign: 'middle'
                            text_size: self.size
                            size_hint_y: None
                            height: dp(20)
                        GridLayout:
                            cols: 3
                            spacing: dp(4)
                            size_hint_y: None
                            height: dp(64)
                            BoxLayout:
                                orientation: 'vertical'
                                Label:
                                    text: app.battery_text
                                    font_name: app.mono_font
                                    font_size: sp(24)
                                    bold: True
                                    color: app.COLOR_PRIMARY
                                    halign: 'center'
                                    valign: 'middle'
                                    text_size: self.size
                                    size_hint_y: None
                                    height: dp(38)
                                Label:
                                    text: '剩余电量'
                                    font_name: app.font_name
                                    font_size: sp(11)
                                    color: app.COLOR_TEXT_WEAK
                                    halign: 'center'
                                    valign: 'top'
                                    text_size: self.size
                                    size_hint_y: None
                                    height: dp(20)
                            BoxLayout:
                                orientation: 'vertical'
                                Label:
                                    text: app.pressure_text
                                    font_name: app.mono_font
                                    font_size: sp(24)
                                    bold: True
                                    color: app.COLOR_BLUE
                                    halign: 'center'
                                    valign: 'middle'
                                    text_size: self.size
                                    size_hint_y: None
                                    height: dp(38)
                                Label:
                                    text: '压力'
                                    font_name: app.font_name
                                    font_size: sp(11)
                                    color: app.COLOR_TEXT_WEAK
                                    halign: 'center'
                                    valign: 'top'
                                    text_size: self.size
                                    size_hint_y: None
                                    height: dp(20)
                            BoxLayout:
                                orientation: 'vertical'
                                Label:
                                    text: app.temp_text
                                    font_name: app.mono_font
                                    font_size: sp(24)
                                    bold: True
                                    color: app.COLOR_WARN_HIGH
                                    halign: 'center'
                                    valign: 'middle'
                                    text_size: self.size
                                    size_hint_y: None
                                    height: dp(38)
                                Label:
                                    text: '温度'
                                    font_name: app.font_name
                                    font_size: sp(11)
                                    color: app.COLOR_TEXT_WEAK
                                    halign: 'center'
                                    valign: 'top'
                                    text_size: self.size
                                    size_hint_y: None
                                    height: dp(20)
                        Label:
                            text: '蓝牙状态：%s' % app.ble_state_text
                            font_name: app.font_name
                            font_size: sp(13)
                            color: app.COLOR_TEXT
                            halign: 'left'
                            valign: 'middle'
                            text_size: self.size
                            size_hint_y: None
                            height: dp(24)
                        Label:
                            text: '设备状态：%s' % app.device_state_text
                            font_name: app.font_name
                            font_size: sp(13)
                            color: app.COLOR_TEXT
                            halign: 'left'
                            valign: 'middle'
                            text_size: self.size
                            size_hint_y: None
                            height: dp(24)
                        Label:
                            text: app.countdown_text
                            font_name: app.mono_font
                            font_size: sp(13)
                            bold: True
                            color: app.COLOR_BLUE
                            halign: 'left'
                            valign: 'middle'
                            text_size: self.size
                            size_hint_y: None
                            height: dp(24)
                            opacity: 1 if app.countdown_text else 0

                    BoxLayout:
                        orientation: 'vertical'
                        size_hint_x: None
                        width: dp(102)
                        spacing: dp(4)
                        Widget:
                        # 徽章：白色瓷片 + 蓝色描边，图片直接绑纹理（不靠路径加载）
                        BoxLayout:
                            size_hint: None, None
                            size: dp(92), dp(92)
                            pos_hint: {'center_x': 0.5}
                            padding: dp(4)
                            canvas.before:
                                Color:
                                    rgba: 1, 1, 1, 1
                                RoundedRectangle:
                                    pos: self.pos
                                    size: self.size
                                    radius: [dp(16)]
                                Color:
                                    rgba: 0.18, 0.50, 0.93, 0.40
                                Line:
                                    width: 1.4
                                    rounded_rectangle: self.x, self.y, self.width, self.height, dp(16)
                            Image:
                                id: badge_image
                                texture: app.badge_texture
                                fit_mode: 'contain'
                        Label:
                            text: '合安智护\n医疗设备蓝牙控制平台'
                            font_name: app.font_name
                            font_size: sp(9)
                            bold: True
                            color: app.COLOR_PRIMARY
                            halign: 'center'
                            valign: 'middle'
                            text_size: self.size
                            size_hint_y: None
                            height: dp(30)
                        Widget:

                # ---------------- 蓝牙 / 患者 / 开发者 ----------------
                BoxLayout:
                    orientation: 'horizontal'
                    spacing: dp(8)
                    size_hint_y: None
                    height: dp(54)
                    SquareButton:
                        text: '蓝牙连接'
                        font_size: sp(13)
                        on_release: root.open_device_dialog()
                    SquareButton:
                        text: '断开连接'
                        font_size: sp(13)
                        filled: False
                        disabled: not app.connected
                        on_release: root.do_disconnect()
                    SquareButton:
                        text: '患者信息'
                        font_size: sp(13)
                        filled: False
                        accent: app.COLOR_BLUE
                        disabled: not app.connected
                        on_release: root.open_patient()
                    SquareButton:
                        text: '开发者'
                        font_size: sp(13)
                        filled: False
                        accent: app.COLOR_TEXT_WEAK
                        on_release: root.open_developer()

                # ---------------- 功能键 3 列 × 4 行 ----------------
                GridLayout:
                    cols: 3
                    spacing: dp(8)
                    size_hint_y: None
                    height: dp(4 * 52 + 3 * 8)
                    SquareButton:
                        text: '充气'
                        font_size: sp(15)
                        filled: False
                        disabled: not app.connected
                        on_release: root.press_function('充气')
                    SquareButton:
                        text: '渐进充气'
                        font_size: sp(15)
                        filled: False
                        disabled: not app.connected
                        on_release: root.press_function('渐进充气')
                    SquareButton:
                        text: '停止充气'
                        font_size: sp(15)
                        filled: False
                        accent: app.COLOR_WARN_HIGH
                        disabled: not app.connected
                        on_release: root.press_function('停止充气')
                    SquareButton:
                        text: '放气'
                        font_size: sp(15)
                        filled: False
                        disabled: not app.connected
                        on_release: root.press_function('放气')
                    SquareButton:
                        text: '渐进放气'
                        font_size: sp(15)
                        filled: False
                        disabled: not app.connected
                        on_release: root.press_function('渐进放气')
                    SquareButton:
                        text: '停止放气'
                        font_size: sp(15)
                        filled: False
                        accent: app.COLOR_WARN_HIGH
                        disabled: not app.connected
                        on_release: root.press_function('停止放气')
                    SquareButton:
                        text: '急停'
                        font_size: sp(16)
                        filled: True
                        accent: app.COLOR_DANGER
                        disabled: not app.connected
                        on_release: root.press_function('急停')
                    SquareButton:
                        text: '复位'
                        font_size: sp(15)
                        filled: False
                        accent: app.COLOR_WARN_HIGH
                        disabled: not app.connected
                        on_release: root.press_function('复位')
                    SquareButton:
                        text: '刷新监测'
                        font_size: sp(15)
                        filled: False
                        accent: app.COLOR_BLUE
                        disabled: not app.connected
                        on_release: root.press_function('刷新监测')
                    SquareButton:
                        text: '附加功能1'
                        font_size: sp(13)
                        filled: False
                        accent: app.COLOR_DISABLED
                        disabled: True
                    SquareButton:
                        text: '附加功能2'
                        font_size: sp(13)
                        filled: False
                        accent: app.COLOR_DISABLED
                        disabled: True
                    SquareButton:
                        text: '附加功能3'
                        font_size: sp(13)
                        filled: False
                        accent: app.COLOR_DISABLED
                        disabled: True

        GateOverlay:
            opacity: 1 if not app.logged_in else 0

# ======================================================================
# 「开发者模式」
# ======================================================================
<DevScreen>:
    FloatLayout:
        canvas.before:
            Color:
                rgba: app.COLOR_BG
            Rectangle:
                pos: self.pos
                size: self.size
        BoxLayout:
            orientation: 'vertical'
            padding: dp(12), dp(10)
            spacing: dp(10)
            DisplayPanel:
                size_hint_y: 1
            BoxLayout:
                orientation: 'horizontal'
                spacing: dp(8)
                size_hint_y: None
                height: dp(54)
                SquareButton:
                    text: '蓝牙连接'
                    font_size: sp(13)
                    on_release: root.open_device_dialog()
                SquareButton:
                    text: '断开连接'
                    font_size: sp(13)
                    filled: False
                    disabled: not app.connected
                    on_release: root.do_disconnect()
                SquareButton:
                    text: '信息复原'
                    font_size: sp(13)
                    filled: False
                    accent: app.COLOR_WARN_HIGH
                    on_release: root.restore_info()
            SquareButton:
                text: '退出开发者模式'
                font_size: sp(14)
                filled: False
                accent: app.COLOR_TEXT_WEAK
                height: dp(48)
                on_release: root.exit_dev()

# ======================================================================
# 「记录」——待办任务 / 已完成折叠 / 交接班摘要
# ======================================================================
<LogsScreen>:
    FloatLayout:
        canvas.before:
            Color:
                rgba: app.COLOR_BG
            Rectangle:
                pos: self.pos
                size: self.size
        ScrollView:
            do_scroll_x: False
            bar_width: dp(2)
            BoxLayout:
                orientation: 'vertical'
                padding: dp(12), dp(10)
                spacing: dp(10)
                size_hint_y: None
                height: self.minimum_height

                Card:
                    SectionTitle:
                        text: '待办任务'
                    SectionNote:
                        text: '勾选即标记完成；批量确认会再问一次'
                    BoxLayout:
                        id: task_list
                        orientation: 'vertical'
                        spacing: dp(8)
                        size_hint_y: None
                        height: self.minimum_height
                    SquareButton:
                        text: '批量确认'
                        font_size: sp(14)
                        height: dp(48)
                        on_release: root.confirm_all()

                Card:
                    Button:
                        id: done_header
                        text: '已完成（0）  ▶'
                        font_name: app.font_name
                        font_size: sp(16)
                        bold: True
                        color: app.COLOR_TEXT
                        halign: 'left'
                        valign: 'middle'
                        text_size: self.size
                        background_normal: ''
                        background_down: ''
                        background_color: 0, 0, 0, 0
                        size_hint_y: None
                        height: dp(36)
                        padding: dp(2), 0
                        on_release: root.toggle_done()
                    BoxLayout:
                        id: done_list
                        orientation: 'vertical'
                        spacing: dp(2)
                        size_hint_y: None
                        height: 0
                        opacity: 0
                        disabled: True

                Card:
                    SectionTitle:
                        text: '交接班摘要'
                    Label:
                        id: summary
                        text: '本班患者名称：未绑定'
                        font_name: app.font_name
                        font_size: sp(15)
                        color: app.COLOR_TEXT
                        halign: 'left'
                        valign: 'top'
                        text_size: self.size
                        size_hint_y: None
                        height: dp(60)

        GateOverlay:
            opacity: 1 if not app.logged_in else 0

# ======================================================================
# 「登录」
# ======================================================================
<MineScreen>:
    FloatLayout:
        canvas.before:
            Color:
                rgba: app.COLOR_BG
            Rectangle:
                pos: self.pos
                size: self.size
        BoxLayout:
            orientation: 'vertical'
            padding: dp(16), dp(12)
            spacing: dp(10)

            GradientPanel:
                color_a: app.GRAD_TEAL_A
                color_b: app.GRAD_TEAL_B
                radius: dp(18)
                size_hint_y: None
                height: dp(116)
                padding: dp(18), dp(12)
                spacing: dp(2)
                Label:
                    text: ('当前用户：%s' % app.current_user) if app.logged_in else '未登录'
                    font_name: app.font_name
                    font_size: sp(20)
                    bold: True
                    color: 1, 1, 1, 1
                    halign: 'left'
                    valign: 'middle'
                    text_size: self.size
                    size_hint_y: None
                    height: dp(30)
                Label:
                    text: '患者名称：%s' % app.patient_label
                    font_name: app.font_name
                    font_size: sp(20)
                    bold: True
                    color: 1, 1, 1, 1
                    halign: 'left'
                    valign: 'middle'
                    text_size: self.size
                    size_hint_y: None
                    height: dp(30)
                Label:
                    text: '已登录，功能解锁完毕！' if app.logged_in else '完成登录后自动解锁全部模块'
                    font_name: app.font_name
                    font_size: sp(13)
                    color: 0.92, 0.99, 0.97, 0.95
                    halign: 'left'
                    valign: 'middle'
                    text_size: self.size
                    size_hint_y: None
                    height: dp(24)

            LongButton:
                text: '用户登录'
                on_release: root.open_login()

            LongButton:
                text: '紧急呼叫'
                disabled: not app.logged_in
                on_release: root.reserved('紧急呼叫')

            LongButton:
                text: '患者信息'
                disabled: not app.logged_in
                on_release: root.open_patient()

            LongButton:
                text: '常见问题'
                disabled: not app.logged_in
                on_release: root.open_faq()

            LongButton:
                text: '版本信息'
                opacity: 1 if app.logged_in else 0
                disabled: not app.logged_in
                size_hint_y: None
                height: dp(56) if app.logged_in else 0
                on_release: root.open_version()

            LongButton:
                text: '退出登录'
                opacity: 1 if app.logged_in else 0
                disabled: not app.logged_in
                size_hint_y: None
                height: dp(56) if app.logged_in else 0
                on_release: root.do_logout()

            Widget:

# ======================================================================
# 登录表单
# ======================================================================
<LoginScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: dp(22), dp(10)
        canvas.before:
            Color:
                rgba: app.COLOR_BG
            Rectangle:
                pos: self.pos
                size: self.size

        GradientPanel:
            color_a: app.GRAD_TEAL_A
            color_b: app.GRAD_TEAL_B
            radius: dp(20)
            size_hint_y: None
            height: dp(96)
            BoxLayout:
                orientation: 'vertical'
                padding: dp(18), dp(14)
                Label:
                    text: '合安智护'
                    font_name: app.font_name
                    font_size: sp(24)
                    bold: True
                    color: 1, 1, 1, 1
                    halign: 'left'
                    valign: 'middle'
                    text_size: self.size
                    size_hint_y: None
                    height: dp(36)
                Label:
                    text: '医疗设备蓝牙控制平台'
                    font_name: app.font_name
                    font_size: sp(13)
                    color: 0.92, 0.99, 0.97, 0.95
                    halign: 'left'
                    valign: 'middle'
                    text_size: self.size
                    size_hint_y: None
                    height: dp(22)

        Widget:
            size_hint_y: None
            height: dp(14)

        Card:
            size_hint_x: 1
            Label:
                text: '账号登录'
                font_name: app.font_name
                font_size: sp(18)
                bold: True
                color: app.COLOR_TEXT
                halign: 'left'
                text_size: self.size
                size_hint_y: None
                height: dp(28)
            FieldInput:
                id: username
                hint_text: '请输入用户名'
                on_text: root.message = ''
            FieldInput:
                id: password
                hint_text: '请输入密码'
                password: True
                on_text: root.message = ''
            Label:
                text: root.message
                font_name: app.font_name
                font_size: sp(12)
                color: app.COLOR_PRIMARY if root.message_ok else app.COLOR_DANGER
                halign: 'left'
                text_size: self.size
                size_hint_y: None
                height: dp(22) if root.message else 0
            SquareButton:
                text: '登 录'
                height: dp(48)
                on_release: root.do_login()
            TextLink:
                text: '还没有账号？点此注册'
                on_release: root.goto_register()

        Widget:

# ======================================================================
# 注册页
# ======================================================================
<RegisterScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: dp(22), dp(10)
        canvas.before:
            Color:
                rgba: app.COLOR_BG
            Rectangle:
                pos: self.pos
                size: self.size

        Widget:
            size_hint_y: 0.06

        Label:
            text: '注册新账号'
            font_name: app.font_name
            font_size: sp(22)
            bold: True
            color: app.COLOR_PRIMARY
            size_hint_y: None
            height: dp(36)

        Label:
            text: '账号仅保存在本机，暂不提供密码找回'
            font_name: app.font_name
            font_size: sp(12)
            color: app.COLOR_TEXT_WEAK
            size_hint_y: None
            height: dp(20)

        Widget:
            size_hint_y: None
            height: dp(14)

        Card:
            size_hint_x: 1
            FieldInput:
                id: username
                hint_text: '设置用户名（3-20 个字符）'
                on_text: root.message = ''
            FieldInput:
                id: password
                hint_text: '设置密码（至少 6 位）'
                password: True
                on_text: root.message = ''
            FieldInput:
                id: confirm
                hint_text: '请再次输入密码'
                password: True
                on_text: root.message = ''
            Label:
                text: root.message
                font_name: app.font_name
                font_size: sp(12)
                color: app.COLOR_PRIMARY if root.message_ok else app.COLOR_DANGER
                halign: 'left'
                text_size: self.size
                size_hint_y: None
                height: dp(22) if root.message else 0
            SquareButton:
                text: '注 册'
                height: dp(48)
                on_release: root.do_register()
            TextLink:
                text: '返回登录'
                on_release: root.back_to_login()

        Widget:

# ======================================================================
# 弹窗（深色底 + 白字，保证任何机型上都看得清）
# ======================================================================
<InfoPopup>:
    title_font: app.font_name
    title_size: sp(15)
    title_color: 1, 1, 1, 1
    separator_color: 1, 1, 1, 0.22
    background_color: 0.06, 0.10, 0.10, 1
    size_hint: 0.92, None
    height: dp(420)
    BoxLayout:
        orientation: 'vertical'
        spacing: dp(6)
        padding: dp(6)
        BoxLayout:
            id: info_lines
            orientation: 'vertical'
            spacing: dp(2)

<DevicePopup>:
    title: '附近的 BLE 设备'
    title_font: app.font_name
    title_size: sp(16)
    title_color: 1, 1, 1, 1
    separator_color: 1, 1, 1, 0.22
    background_color: 0.06, 0.10, 0.10, 1
    size_hint: 0.94, 0.86
    BoxLayout:
        orientation: 'vertical'
        spacing: dp(6)
        padding: dp(6)
        Label:
            id: popup_status
            text: '正在扫描…'
            font_name: app.font_name
            font_size: sp(12)
            color: 0.86, 0.96, 0.94, 1
            halign: 'left'
            text_size: self.size
            size_hint_y: None
            height: dp(22)
        ScrollView:
            do_scroll_x: False
            bar_width: dp(3)
            GridLayout:
                id: device_list
                cols: 1
                spacing: dp(6)
                size_hint_y: None
                height: self.minimum_height
        Label:
            id: popup_diag
            text: ''
            font_name: app.font_name
            font_size: sp(10)
            color: 0.78, 0.90, 0.86, 1
            halign: 'left'
            valign: 'top'
            text_size: self.size
            size_hint_y: None
            height: dp(18)
        BoxLayout:
            orientation: 'horizontal'
            spacing: dp(8)
            size_hint_y: None
            height: dp(44)
            SquareButton:
                text: '我的收藏'
                font_size: sp(13)
                height: dp(44)
                on_release: root.open_favorites()
            SquareButton:
                text: '重新扫描'
                font_size: sp(13)
                height: dp(44)
                on_release: root.restart_scan()
            SquareButton:
                text: '关闭'
                font_size: sp(13)
                height: dp(44)
                filled: False
                on_release: root.dismiss()

<FavoritePopup>:
    title: '我的收藏'
    title_font: app.font_name
    title_size: sp(16)
    title_color: 1, 1, 1, 1
    separator_color: 1, 1, 1, 0.22
    background_color: 0.06, 0.10, 0.10, 1
    size_hint: 0.94, 0.8
    BoxLayout:
        orientation: 'vertical'
        spacing: dp(6)
        padding: dp(6)
        Label:
            id: fav_state
            text: '只显示当前扫描得到的收藏设备'
            font_name: app.font_name
            font_size: sp(12)
            color: 0.86, 0.96, 0.94, 1
            halign: 'left'
            text_size: self.size
            size_hint_y: None
            height: dp(22)
        ScrollView:
            do_scroll_x: False
            bar_width: dp(3)
            GridLayout:
                id: fav_list
                cols: 1
                spacing: dp(6)
                size_hint_y: None
                height: max(self.minimum_height, self.parent.height)
        BoxLayout:
            orientation: 'horizontal'
            spacing: dp(8)
            size_hint_y: None
            height: dp(44)
            SquareButton:
                text: '关 闭'
                font_size: sp(13)
                height: dp(44)
                filled: False
                on_release: root.dismiss()

<ServicesPopup>:
    title: '服务 / 特征'
    title_font: app.font_name
    title_size: sp(16)
    title_color: 1, 1, 1, 1
    separator_color: 1, 1, 1, 0.22
    background_color: 0.06, 0.10, 0.10, 1
    size_hint: 0.94, 0.9
    BoxLayout:
        orientation: 'vertical'
        spacing: dp(6)
        padding: dp(6)
        Label:
            text: '下面列出设备暴露的全部服务与特征。把要写入的 UUID 填进 main.py 的 ESP32_WRITE_UUID 即可。'
            font_name: app.font_name
            font_size: sp(11)
            color: 0.78, 0.90, 0.86, 1
            halign: 'left'
            valign: 'top'
            text_size: self.size
            size_hint_y: None
            height: dp(34)
        Label:
            id: service_state
            text: '尚未发现服务'
            font_name: app.font_name
            font_size: sp(11)
            color: 1, 1, 1, 0.96
            halign: 'left'
            valign: 'top'
            text_size: self.size
            size_hint_y: None
            height: dp(46)
        ScrollView:
            do_scroll_x: False
            bar_width: dp(3)
            GridLayout:
                id: service_list
                cols: 1
                spacing: dp(6)
                size_hint_y: None
                height: max(self.minimum_height, self.parent.height)
        Label:
            id: module_state
            text: '模块信息（AT 通道读取）：准备中…'
            font_name: app.font_name
            font_size: sp(11)
            color: 1, 1, 1, 0.96
            halign: 'left'
            valign: 'top'
            text_size: self.size
            size_hint_y: None
            height: dp(18)
        DiagLine:
            id: svc_diag_1
            text: '固件版本：未查询'
        DiagLine:
            id: svc_diag_2
            text: '设备角色：未查询'
        DiagLine:
            id: svc_diag_3
            text: '串口波特率：未查询'
        DiagLine:
            id: svc_diag_4
            text: '状态显示：未查询'
        DiagLine:
            id: svc_diag_5
            text: '用户鉴权：未查询'
        DiagLine:
            id: svc_diag_6
            text: '设备名称：未查询'
        BoxLayout:
            orientation: 'horizontal'
            spacing: dp(6)
            size_hint_y: None
            height: dp(42)
            SquareButton:
                text: '重新发现'
                font_size: sp(11)
                height: dp(42)
                filled: False
                on_release: root.retry_discovery()
            SquareButton:
                text: '复制列表'
                font_size: sp(11)
                height: dp(42)
                filled: False
                on_release: root.copy_list()
            SquareButton:
                text: '刷新信息'
                font_size: sp(11)
                height: dp(42)
                filled: False
                on_release: root.refresh_module_info()
            SquareButton:
                text: '关闭'
                font_size: sp(11)
                height: dp(42)
                filled: False
                on_release: root.dismiss()

<CommandInputPopup>:
    title: '自定义包'
    title_font: app.font_name
    title_size: sp(15)
    title_color: 1, 1, 1, 1
    separator_color: 1, 1, 1, 0.22
    background_color: 0.06, 0.10, 0.10, 1
    size_hint: 0.95, 0.84
    BoxLayout:
        orientation: 'vertical'
        spacing: dp(6)
        padding: dp(6)

        Label:
            text: '填入十六进制命令包（偶数长度，例如 5401008031），点「发送」写进数据通道'
            font_name: app.font_name
            font_size: sp(11)
            color: 0.78, 0.90, 0.86, 1
            halign: 'left'
            valign: 'top'
            text_size: self.size
            size_hint_y: None
            height: dp(32)

        TextInput:
            id: cmd_input
            text: root.command
            font_name: app.font_name
            font_size: sp(13)
            multiline: False
            size_hint_y: None
            height: dp(44)
            on_text: root.command = self.text

        BoxLayout:
            orientation: 'horizontal'
            spacing: dp(6)
            size_hint_y: None
            height: dp(44)
            SquareButton:
                text: '发送'
                font_size: sp(13)
                height: dp(44)
                on_release: root.send()
            SquareButton:
                text: '关闭'
                font_size: sp(13)
                height: dp(44)
                filled: False
                on_release: root.dismiss()

        Label:
            text: root.state
            font_name: app.font_name
            font_size: sp(11)
            color: 0.86, 0.96, 0.94, 1
            halign: 'left'
            valign: 'top'
            text_size: self.size
            size_hint_y: None
            height: dp(32)

        BoxLayout:
            id: cmd_reply
            orientation: 'vertical'
            spacing: dp(2)

<BaudRatePopup>:
    title: '波特率（AT+UART）'
    title_font: app.font_name
    title_size: sp(15)
    title_color: 1, 1, 1, 1
    separator_color: 1, 1, 1, 0.22
    background_color: 0.06, 0.10, 0.10, 1
    size_hint: 0.95, 0.72
    BoxLayout:
        orientation: 'vertical'
        spacing: dp(8)
        padding: dp(6)

        Label:
            text: '用 AT 指令实时修改模块串口波特率（立即生效、掉电保存）；每次连接 App 会自动锁成 9600'
            font_name: app.font_name
            font_size: sp(11)
            color: 0.78, 0.90, 0.86, 1
            halign: 'left'
            valign: 'top'
            text_size: self.size
            size_hint_y: None
            height: dp(34)

        TextInput:
            id: baud_input
            text: root.value
            font_name: app.font_name
            font_size: sp(14)
            multiline: False
            input_filter: 'int'
            size_hint_y: None
            height: dp(44)
            on_text: root.value = self.text

        BoxLayout:
            orientation: 'horizontal'
            spacing: dp(8)
            size_hint_y: None
            height: dp(44)
            SquareButton:
                text: '9600'
                font_size: sp(14)
                height: dp(44)
                on_release: root.choose(9600)
            SquareButton:
                text: '115200'
                font_size: sp(14)
                height: dp(44)
                on_release: root.choose(115200)

        BoxLayout:
            orientation: 'horizontal'
            spacing: dp(8)
            size_hint_y: None
            height: dp(44)
            SquareButton:
                text: '发送'
                font_size: sp(14)
                height: dp(44)
                on_release: root.send()
            SquareButton:
                text: '关闭'
                font_size: sp(14)
                height: dp(44)
                filled: False
                on_release: root.dismiss()

        Label:
            text: root.state
            font_name: app.font_name
            font_size: sp(11)
            color: 0.86, 0.96, 0.94, 1
            halign: 'left'
            valign: 'top'
            text_size: self.size
            size_hint_y: None
            height: dp(34)

        BoxLayout:
            id: baud_reply
            orientation: 'vertical'
            spacing: dp(2)

<ConfirmPopup>:
    title_font: app.font_name
    title_size: sp(16)
    title_color: 1, 1, 1, 1
    separator_color: 1, 1, 1, 0.22
    background_color: 0.06, 0.10, 0.10, 1
    size_hint: 0.9, 0.42
    BoxLayout:
        orientation: 'vertical'
        spacing: dp(10)
        padding: dp(8)
        Label:
            text: root.message
            font_name: app.font_name
            font_size: sp(14)
            color: 1, 1, 1, 0.96
            halign: 'left'
            valign: 'top'
            text_size: self.size
        BoxLayout:
            orientation: 'horizontal'
            spacing: dp(10)
            size_hint_y: None
            height: dp(46)
            SquareButton:
                text: '取消'
                font_size: sp(14)
                height: dp(46)
                filled: False
                accent: app.COLOR_DISABLED
                on_release: root.dismiss()
            SquareButton:
                text: '确认'
                font_size: sp(14)
                height: dp(46)
                on_release: root.confirm()

<PatientPopup>:
    title_font: app.font_name
    title_size: sp(16)
    title_color: 1, 1, 1, 1
    separator_color: 1, 1, 1, 0.22
    background_color: 0.06, 0.10, 0.10, 1
    size_hint: 0.94, 0.66
    BoxLayout:
        orientation: 'vertical'
        spacing: dp(6)
        padding: dp(8)

        Label:
            text: '第一行：患者姓名 / 床号（可包含中文、英文、数字）'
            font_name: app.font_name
            font_size: sp(11)
            color: 0.78, 0.90, 0.86, 1
            halign: 'left'
            valign: 'top'
            text_size: self.size
            size_hint_y: None
            height: dp(30)

        TextInput:
            id: p_label
            text: root.label_text
            font_name: app.font_name
            font_size: sp(14)
            multiline: False
            size_hint_y: None
            height: dp(44)
            on_text: root.label_text = self.text

        Label:
            text: '第二行：蓝牙设备名称（只能英文和数字，用于改模块名）'
            font_name: app.font_name
            font_size: sp(11)
            color: 0.78, 0.90, 0.86, 1
            halign: 'left'
            valign: 'top'
            text_size: self.size
            size_hint_y: None
            height: dp(30)

        TextInput:
            id: p_name
            text: root.name_text
            font_name: app.font_name
            font_size: sp(14)
            multiline: False
            size_hint_y: None
            height: dp(44)
            on_text: root.name_text = self.text

        Label:
            text: root.state_text
            font_name: app.font_name
            font_size: sp(11)
            color: 0.98, 0.72, 0.68, 1
            halign: 'left'
            valign: 'top'
            text_size: self.size
            size_hint_y: None
            height: dp(30)

        Widget:

        BoxLayout:
            orientation: 'horizontal'
            spacing: dp(8)
            size_hint_y: None
            height: dp(46)
            SquareButton:
                text: '取消'
                font_size: sp(14)
                height: dp(46)
                filled: False
                accent: app.COLOR_DISABLED
                on_release: root.dismiss()
            SquareButton:
                text: '确认'
                font_size: sp(14)
                height: dp(46)
                on_release: root.confirm()
